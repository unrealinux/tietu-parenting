# 育儿贴图号 —— 微信服务号配置模板
# 复制为 .env 后填入真实值。.env 不要提交到 git。

WECHAT_APP_ID=填服务号的AppID
WECHAT_APP_SECRET=填服务号的AppSecret

# 可选：走代理时启用
# USE_PROXY=false

# Agnes 生图（--style anime/comic 用）
AGNES_API_KEY=
# 可选：默认 https://apihub.agnes-ai.com/v1/images/generations
# AGNES_API_URL=
# 可选：默认 agnes-image-2.1-flash
# AGNES_MODEL=

# 可选：gen_topics.py 写文案用哪家模型（默认 deepseek-flash，走本机 pi 登录态）
# TEXT_MODEL=deepseek-flash
# TEXT_API_KEY=
# TEXT_BASE_URL=
